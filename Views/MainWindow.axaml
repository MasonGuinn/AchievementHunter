<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AchievementHunter.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        Width="500" Height="350"
        WindowStartupLocation="CenterScreen"
        x:Class="AchievementHunter.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Achievement Hunter - API Setup">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <!-- Center layout container with smooth spacing -->
  <StackPanel VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Spacing="20"
              Width="400">

    <TextBlock Text="AH Engine Handshake"
               FontSize="22"
               FontWeight="Bold"
               HorizontalAlignment="Center"/>

    <!-- Bordered card to show the live response from the engine -->
    <Border Background="#1e1e24"
            BorderBrush="#2d2d34"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15"
            MinHeight="80">
      <TextBlock Text="{Binding ConnectionStatus}"
                 Foreground="#a9b1d6"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"/>
    </Border>

    <!-- Asynchronous Trigger Button -->
    <Button Content="Test Connection"
            Command="{Binding TestConnectionCommand}"
            IsEnabled="{Binding IsButtonEnabled}"
            Background="#2563eb"
            Foreground="White"
            Padding="10,12"
            CornerRadius="6"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            Width="160"/>
  </StackPanel>
</Window>